# Скопируйте этот файл в .env и вставьте свой ключ
# Получить ключ: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Модель для анализа личности/профориентации и для чата
MODEL_MAIN=claude-sonnet-5

# Модель для распознавания фото (физиогномика) — эта же модель умеет "смотреть" изображения
MODEL_VISION=claude-sonnet-5

# Порт локального сервера
PORT=3000
